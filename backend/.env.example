NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-domain.com

MONGODB_URI=mongodb+srv://user:password@cluster.example.com/instagram
MONGODB_TIMEOUT_MS=10000

JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
ACCESS_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_EXPIRES_IN=7

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

REDIS_URL=redis://default:password@host:6379
CACHE_TTL_SECONDS=60
WORKERS_ENABLED=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="Instagram MERN <no-reply@your-domain.com>"

SIGNUP_OTP_EXPIRES_MINUTES=10
MAX_SIGNUP_VERIFICATION_ATTEMPTS=5
