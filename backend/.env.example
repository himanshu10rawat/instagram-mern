NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MONGODB_URI=mongodb+srv://user:password@cluster.example.com/pixelfeed
MONGODB_TIMEOUT_MS=10000

JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
ACCESS_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_EXPIRES_IN=7

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_RTC_TOKEN_EXPIRES_IN_SECONDS=3600

CACHE_TTL_SECONDS=60

EMAIL_PROVIDER=brevo
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM="pixelFeed <no-reply@your-verified-domain.com>"
SMTP_POOL_MAX_CONNECTIONS=3
SMTP_POOL_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
BREVO_API_TIMEOUT_MS=10000
EMAIL_SEND_ATTEMPTS=2
EMAIL_SEND_RETRY_DELAY_MS=1000

SIGNUP_OTP_EXPIRES_MINUTES=10
MAX_SIGNUP_VERIFICATION_ATTEMPTS=5
